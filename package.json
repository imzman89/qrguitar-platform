{
  "name": "qrguitar-platform",
  "private": true,
  "version": "0.1.0",
  "description": "QRguitar instrument Profiles, ownership history, QR tools, and installable web app.",
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "lint": "npm --workspaces run lint",
    "typecheck": "npm --workspaces run typecheck",
    "deploy:web": "npm run push:live",
    "push:live": "node scripts/push-live.mjs",
    "release:database": "node scripts/check-release-readiness.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "postcss": "8.5.28",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
