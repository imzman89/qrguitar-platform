# QRguitar web app environment.
# Copy this file to apps/web/.env.local for local development.

# Browser-safe Supabase values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL used for QR/profile links.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3003

# Optional browser tracking purposes. Leave blank to load no analytics or advertising
# and show no consent notice. Supported explicit values: analytics,advertising.
NEXT_PUBLIC_OPTIONAL_TRACKING_PURPOSES=

# Public app-signing identities, supplied server-side only after ownership verification.
# Leave blank until signed apps exist; well-known routes then return no-store 404.
# See scripts/NATIVE_ASSOCIATIONS.md for signing and direct-host routing requirements.
QRGUITAR_APPLE_TEAM_ID=
QRGUITAR_ANDROID_SHA256_CERT_FINGERPRINTS=

# Optional comma-separated emails that receive owner/commercial MVP privileges.
# Example: owner@example.com,shop@example.com
QRGUITAR_ADMIN_EMAILS=
QRGUITAR_BETA_TESTER_EMAILS=

# Optional future AI integration. Leave blank unless explicitly wiring AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# QRguitar production email labels. Do not put SMTP passwords in this file.
NEXT_PUBLIC_SUPPORT_EMAIL=support@qrguitar.com
NEXT_PUBLIC_CONTACT_EMAIL=support@qrguitar.com
EMAIL_FROM=QRguitar <noreply@qrguitar.com>
SMTP_FROM=noreply@qrguitar.com
SMTP_REPLY_TO=support@qrguitar.com

# Server-only automatic PayPal checkout. Blank credentials and false flags keep it off.
# See docs/PAYPAL_CHECKOUT_SETUP.md. Enter real secrets only in private server settings.
# Never commit credentials or send them in chat; do not prefix secrets with NEXT_PUBLIC_.
QRGUITAR_PAYPAL_ENABLED=false
# Use test only with a Sandbox REST app and the isolated test settings below.
# Live requires a separate Live app, merchant identity, and webhook registration.
PAYPAL_ENVIRONMENT=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Private Bearer secret for scheduled recovery calls (32+ chars).
CRON_SECRET=
# Separate activation: merchant eligibility, domain registration, and SDK required.
QRGUITAR_PAYPAL_APPLE_PAY_ENABLED=false

# Retained direct business payments. Blank receiving details keep new purchases off.
# See docs/DIRECT_PAYMENTS_OPERATIONS.md. Never commit actual receiving details.
QRGUITAR_DIRECT_PAYMENTS_ENABLED=false
QRGUITAR_DIRECT_MERCHANT_NAME=
QRGUITAR_DIRECT_PAYMENT_METHODS=[]
QRGUITAR_DIRECT_APPROVAL_MESSAGE=
# Shared ledger mode; this alone does not enable payments.
# Sandbox tests require test here AND PAYPAL_ENVIRONMENT=test with an isolated database.
QRGUITAR_BILLING_ENVIRONMENT=live

# Legacy Stripe billing remains disabled. Direct payments need no Stripe secrets.
# See docs/BILLING_OPERATIONS.md for historical/legacy order operation.
QRGUITAR_BILLING_ENABLED=false
STRIPE_ENVIRONMENT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_API_VERSION=2026-08-26.dahlia
STRIPE_PRICE_PROFILE_1=
STRIPE_PRICE_PROFILE_10=
STRIPE_PRICE_PROFILE_25=
# Test mode requires a separate, explicitly provisioned Supabase sandbox.
# Never set this to the production database.
QRGUITAR_BILLING_TEST_DATABASE_URL=
# Test-only checkout return origin, shared by PayPal and legacy Stripe.
# Use isolated HTTPS; PayPal also permits localhost/127.0.0.1 development.
# Never use production QRguitar hostnames for the test app origin.
QRGUITAR_BILLING_TEST_APP_URL=
