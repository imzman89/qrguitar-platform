# These values are public and will be bundled into the client. Supply them as
# process environment variables to the guarded export scripts. Never use a
# service-role, secret, admin, payment, database or signing credential here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=  # Legacy public anon JWT fallback only.
EXPO_PUBLIC_API_ORIGIN=https://www.qrguitar.com
