{
  "expo": {
    "name": "QRguitar",
    "slug": "qrguitar",
    "scheme": "qrguitar",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qrguitar.app",
      "associatedDomains": [
        "applinks:qrguitar.com",
        "applinks:www.qrguitar.com"
      ],
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.qrguitar.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "qrguitar.com",
              "pathPrefix": "/i/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.qrguitar.com",
              "pathPrefix": "/i/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-status-bar",
      "expo-image",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose instrument photos for your QRguitar profile.",
          "cameraPermission": "Allow QRguitar to scan instrument QR codes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow QRguitar to scan instrument QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-system-ui"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/qrguitar-icon.png"
    },
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "icon": "./assets/qrguitar-icon.png"
  }
}
