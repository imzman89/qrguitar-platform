{
  "name": "@qrguitar/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "export:android": "node scripts/export-native.mjs --platform android",
    "export:ios": "node scripts/export-native.mjs --platform ios",
    "export:web": "node scripts/export-native.mjs --platform web",
    "test:config": "node scripts/check-native-config.mjs",
    "test:runtime-bundles": "node scripts/check-runtime-bundles.mjs",
    "test:qr-input": "node scripts/test-qr-input.mjs",
    "test": "npm run test:config && npm run test:export-environment && npm run test:qr-input && npm run test:core && npm run test:scanner && npm run test:xcode-uuid && npm run test:ui",
    "test:xcode-uuid": "node scripts/test-xcode-uuid.mjs",
    "test:core": "node scripts/test-native-core.mjs",
    "export:all": "node scripts/export-native.mjs --platform all",
    "export:web:dev": "node scripts/export-native.mjs --platform web --dev --no-minify",
    "test:export-environment": "node scripts/test-export-environment.mjs",
    "test:scanner": "node scripts/test-native-scanner.mjs",
    "test:ui": "node scripts/test-native-ui.mjs"
  },
  "dependencies": {
    "@qrguitar/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.21",
    "expo-camera": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "expo-system-ui": "~57.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "react-test-renderer": "19.2.3"
  }
}
